# =============================================================================
# Evoq — Environment variables (example template)
# =============================================================================
# To use: copy this file to `.env.local` and fill in your real values.
#
#   cp .env.example .env.local
#
# Never commit `.env.local` — it is gitignored (see .gitignore). This file
# contains PLACEHOLDER values only; there are no real credentials here.
#
# Without Firebase/Stripe config the app degrades gracefully: guests-only
# mode (no sign-in UI) and payments disabled (/api/checkout → 503).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — PUBLIC client configuration (safe to ship in the browser bundle;
# these are NOT secrets). Get them from Firebase console → Project settings →
# Your apps → SDK setup and configuration ("firebaseConfig" snippet).
# The first four are required; the rest are optional but recommended.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Stripe — SERVER SECRET KEY. Never expose this, never use a NEXT_PUBLIC_
# prefix. From Stripe Dashboard → Developers → API keys (a restricted key
# with checkout.session create/read access is recommended).
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# -----------------------------------------------------------------------------
# Stripe — CLIENT publishable key (safe to ship in the browser). From the
# same Stripe Dashboard → API keys page (starts with pk_).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# -----------------------------------------------------------------------------
# Stripe — Price IDs for each paid plan + billing cycle. From Stripe
# Dashboard → Products → each price's ID (starts with price_). The "basic"
# plan is free and intentionally has no price ID.
# -----------------------------------------------------------------------------
STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual_id
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
STRIPE_PRICE_LIFETIME=price_your_lifetime_id

# -----------------------------------------------------------------------------
# Stripe — WEBHOOK SIGNING SECRET. Required by /api/stripe/webhook to verify
# that event payloads actually come from Stripe. Get it from Stripe Dashboard
# → Developers → Webhooks → your endpoint → "Signing secret" (starts with
# whsec_). NEVER commit or expose it.
# -----------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# -----------------------------------------------------------------------------
# Firebase Admin — SERVER-SIDE service account (JSON). Enables server-side
# ID-token verification (firebase-admin) and the Firestore entitlement
# records that back Pro/Lifetime access. Generate it in Firebase Console →
# Project settings → Service accounts → "Generate new private key", then
# paste the JSON here. SERVER-ONLY — never expose or prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id"}

# -----------------------------------------------------------------------------
# Azure Speech — SERVER-ONLY cloud voice fallback. Create a Speech resource in
# Azure, then copy its key and region. Never prefix either value with
# NEXT_PUBLIC_: the browser calls the authenticated /api/tts route and cannot
# read these credentials. Example regions: eastus, southeastasia.
# -----------------------------------------------------------------------------
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# -----------------------------------------------------------------------------
# Admin — SERVER-SIDE manual/gift entitlement management. Comma-separated list
# of Firebase UIDs allowed to call POST /api/admin/entitlements/grant and
# /api/admin/entitlements/revoke (used to gift Pro/Lifetime to friends,
# testers, creators or support cases without a Paddle payment). SERVER-ONLY —
# never expose, never use a NEXT_PUBLIC_ prefix. No value = no admins: the
# admin endpoints return 403 for everyone. Use Firebase UIDs, not emails.
# -----------------------------------------------------------------------------
ADMIN_UIDS=

# -----------------------------------------------------------------------------
# Paddle — ACTIVE payment provider (Stripe code is retained for rollback, but
# /api/checkout and the webhook path are Paddle now). The Stripe variables
# above remain documented until the migration cleanup phase removes them.
#
# Paddle — SERVER API KEY. Server-only, never use a NEXT_PUBLIC_ prefix.
# From Paddle Billing → Developer tools → Authentication.
# -----------------------------------------------------------------------------
PADDLE_API_KEY=pdl_test_your_api_key_here

# -----------------------------------------------------------------------------
# Paddle — CLIENT token (safe to ship in the browser; the only Paddle value
# that may use NEXT_PUBLIC_). From Paddle Billing → Developer tools →
# Authentication → "Client-side token" (starts with pdl_ or is a JWT).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=pdl_test_your_client_token_here

# -----------------------------------------------------------------------------
# Paddle — CLIENT environment override. Tells Paddle.js which checkout
# environment to use: "sandbox" for Preview/sandbox testing, "production" (or
# unset) for production. Must be a NEXT_PUBLIC_ variable because Paddle.js
# runs in the browser — it mirrors the server-side PADDLE_ENV above.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PADDLE_ENV=production

# -----------------------------------------------------------------------------
# Vercel — PREVIEW-ONLY protected-redirect bypass query. Used ONLY when the
# Preview deployment sits behind Vercel Authentication: after a sandbox
# payment, Paddle redirects the browser to /checkout/success and the bypass
# query is what lets that redirect land on the protected Preview.
#
# Value must be ONLY the query portion, no leading "?":
#   x-vercel-protection-bypass=<secret>
#
# SECURITY: this is a URL credential for the Preview. Keep it Preview-only,
# never in source, never in logs. Production MUST leave it empty/unset (the
# code then builds the plain /checkout/success URL). Revoke the bypass after
# the sandbox E2E is complete.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VERCEL_BYPASS_QUERY=

# -----------------------------------------------------------------------------
# Paddle — Price IDs for each paid plan + billing cycle (Paddle Billing →
# Catalog → each price's ID, starts with pri_). These match the live Paddle
# catalog prices for the migration. The "basic" plan is free and has none.
# -----------------------------------------------------------------------------
PADDLE_PRICE_PRO_MONTHLY=pri_01kzxhbqja0z366pfvcybxdtwq
PADDLE_PRICE_PRO_ANNUAL=pri_01kzxhz8tr1tb20y41wnax798e
PADDLE_PRICE_LIFETIME=pri_01kzxj29ncf6xdygk2tcpat5yq

# -----------------------------------------------------------------------------
# Paddle — WEBHOOK SIGNING SECRET. Required by /api/paddle/webhook to verify
# event payloads come from Paddle (Paddle Dashboard → Developer tools →
# Webhooks → your endpoint → "Webhook secret"). SERVER-ONLY.
# -----------------------------------------------------------------------------
PADDLE_WEBHOOK_SECRET=pdl_webhook_secret_placeholder

# -----------------------------------------------------------------------------
# Paddle — OPTIONAL environment override. Defaults to production; set to
# "sandbox" only when testing against the Paddle sandbox API.
# -----------------------------------------------------------------------------
# PADDLE_ENV=production
